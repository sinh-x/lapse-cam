<resources>
    <style name="Theme.TimestampTimelapse" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FFD166</item>
        <item name="android:colorBackground">#090B0D</item>
        <item name="android:textColorPrimary">#F4F5F6</item>
        <item name="android:textColorSecondary">#B6BEC6</item>
        <item name="android:buttonStyle">@style/Widget.TimestampTimelapse.Button</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#090B0D</item>
    </style>
    <style name="Widget.TimestampTimelapse.Button" parent="android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:colorButtonNormal">#1C2024</item>
        <item name="android:textColor">#F4F5F6</item>
    </style>
</resources>
